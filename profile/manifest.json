{
  "schema_version": 1,
  "name": "Ardoton",
  "version": "0.2.5",
  "license": "GPL-2.0-or-later",
  "ardour": {
    "supported": ["9.7"],
    "tested": ["9.7.0"],
    "config_major": 9
  },
  "platforms": {
    "macos": {
      "config_directory": "~/Library/Preferences/Ardour9",
      "keymap": "keybindings/macos/ardour.keys"
    }
  },
  "theme": "theme/ardoton-ardour.colors",
  "preferences": "preferences/ui-options.tsv",
  "lua_action_slots": {
    "17": "Ardoton: Duplicate Time",
    "18": "Ardoton: Clear Region Fades",
    "19": "Ardoton: Toggle Triplet Grid",
    "20": "Ardoton: Lengthen Loop",
    "21": "Ardoton: Shorten Loop",
    "22": "Ardoton: Double Loop Length",
    "23": "Ardoton: Halve Loop Length",
    "24": "Ardoton: Move Loop Forward by Loop Length",
    "25": "Ardoton: Move Loop Back by Loop Length",
    "26": "Ardoton: Nudge Loop Right",
    "27": "Ardoton: Nudge Loop Left",
    "28": "Ardoton: Add Stereo Audio Track",
    "29": "Ardoton: Add MIDI Track",
    "30": "Ardoton: Add Return",
    "31": "Ardoton: Set and Toggle Loop",
    "32": "Ardoton: Duplicate Tracks"
  },
  "grid_snap_defaults": {
    "ui_config": {
      "snap-threshold": "10",
      "ruler-granularity": "250",
      "snap-target": "SnapTargetBoth",
      "rulers-follow-grid": "1"
    },
    "instant_xml": {
      "Editor": {
        "grid-type": "GridTypeBeatDiv32",
        "snap-mode": "SnapMagnetic"
      },
      "MIDICueEditor": {
        "grid-type": "GridTypeBeatDiv32",
        "snap-mode": "SnapMagnetic"
      }
    }
  }
}
