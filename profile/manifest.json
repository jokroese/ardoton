{
  "schema_version": 1,
  "name": "Ardourton",
  "version": "0.2.3",
  "license": "GPL-2.0-or-later",
  "ardour": {
    "supported": ["9.7"],
    "tested": ["9.7.0"],
    "config_major": 9
  },
  "platforms": {
    "macos": {
      "config_directory": "~/Library/Preferences/Ardour9",
      "keymap": "keybindings/macos/ardour.keys"
    }
  },
  "theme": "theme/ardourton-ardour.colors",
  "preferences": "preferences/ui-options.tsv",
  "lua_action_slots": {
    "17": "Ardourton: Duplicate Time",
    "18": "Ardourton: Clear Region Fades",
    "19": "Ardourton: Toggle Triplet Grid",
    "20": "Ardourton: Lengthen Loop",
    "21": "Ardourton: Shorten Loop",
    "22": "Ardourton: Double Loop Length",
    "23": "Ardourton: Halve Loop Length",
    "24": "Ardourton: Move Loop Forward by Loop Length",
    "25": "Ardourton: Move Loop Back by Loop Length",
    "26": "Ardourton: Nudge Loop Right",
    "27": "Ardourton: Nudge Loop Left",
    "28": "Ardourton: Add Stereo Audio Track",
    "29": "Ardourton: Add MIDI Track",
    "30": "Ardourton: Add Return",
    "31": "Ardourton: Set and Toggle Loop",
    "32": "Ardourton: Duplicate Tracks"
  },
  "grid_snap_defaults": {
    "ui_config": {
      "snap-threshold": "10",
      "ruler-granularity": "250",
      "snap-target": "SnapTargetBoth",
      "rulers-follow-grid": "1"
    },
    "instant_xml": {
      "Editor": {
        "grid-type": "GridTypeBeatDiv32",
        "snap-mode": "SnapMagnetic"
      },
      "MIDICueEditor": {
        "grid-type": "GridTypeBeatDiv32",
        "snap-mode": "SnapMagnetic"
      }
    }
  }
}
